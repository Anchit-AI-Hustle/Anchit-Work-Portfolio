{
  "name": "anchit-portfolio",
  "version": "1.0.0",
  "description": "Anchit Tandon — Senior PM portfolio. Static web + PWA + native iOS/Android via Capacitor.",
  "private": true,
  "scripts": {
    "dev": "npx --yes serve@latest -l ${PORT:-5173} .",
    "dev:built": "npm run build && npx --yes serve@latest -l ${PORT:-5173} www",
    "build": "node scripts/build-www.mjs && node scripts/copy-ayushi.mjs",
    "preview": "npx --yes serve@latest -l 4173 www",
    "tts:serve": "cd tts-server && .venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000",
    "sarvam:check": "node scripts/sarvam-check.mjs",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:add:android": "npm run build && npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "test:providers": "node scripts/provider-chain.js",
    "test:cards": "node scripts/build-cards.js",
    "test:entrance": "node scripts/stuck-entrance.js",
    "test:cascade": "node scripts/cascade-e2e.js",
    "test:design": "node scripts/design-system.js",
    "test:course": "node scripts/course-check.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "yarn": "^1.22.22"
  },
  "engines": {
    "node": ">=18"
  }
}
