+def timeout_s() -> float:
+    """Seconds this take may spend listening. Zero means skip: the make deadline is too close
+    to start a recogniser that cannot be killed mid-forward-pass.
+
+    2026-11-02-5 take 2 rendered in 10 min, then faster-whisper on the full mix with no
+    voice-activity filter never returned (kick-drum hallucination); the job was cancelled
+    102 minutes later. 2026-11-03-3 hung the same way for hours. A missing check is a
+    warning; a hung check is a missed day."""
+    configured = float(os.environ.get("ANCHOR_LYRIC_CHECK_TIMEOUT") or DEFAULT_TIMEOUT_S)
+    deadline = os.environ.get("ANCHOR_MAKE_DEADLINE")
+    if not deadline:
+        return configured
+    remain = float(deadline) - time.time()
+    if remain < 20:
+        return 0.0
+    return min(configured, max(15.0, remain - 30.0))
+
+
+def _model(model_size: str):
+    from faster_whisper import WhisperModel
+    if model_size not in _MODELS:
+        _MODELS[model_size] = WhisperModel(model_size, device="cpu", compute_type="int8")
+    return _MODELS[model_size]
