-def released_prints(catalog_path: Path, work: Path, limit: int = 40) -> dict[str, dict]:
+def catalogue_window(drops: list, limit: int | None = None) -> list:
+    """Which released tracks uniqueness hears. Newest-first catalogue: a numeric cap used
+    to keep only the head, which dropped the original nine Suno records once forty later
+    drops existed. With a cap, keep the newest half and the oldest half."""
+    if limit is None or len(drops) <= limit:
+        return list(drops)
+    keep = max(1, limit // 2)
+    return list(drops[:keep]) + list(drops[-keep:])
+
+
+def released_prints(catalog_path: Path, work: Path, limit: int | None = None) -> dict[str, dict]:
     """Prints of the released masters, cached as .npz. On the Mac the cache is shared across
