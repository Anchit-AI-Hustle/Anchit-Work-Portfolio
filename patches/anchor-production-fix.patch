         log(f"lyriccheck: recogniser unavailable ({str(exc)[:120]})")
         return None
@@ -131,14 +168,35 @@ def hear(audio: Path, title: str | None = None, model_size: str = "small") -> st
         with tempfile.TemporaryDirectory() as tmp:
             wav = Path(tmp) / "mono16k.wav"
             subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(audio), "-ac", "1", "-ar", "16000", str(wav)],
-                           check=True, capture_output=True)
+                           check=True, capture_output=True, timeout=60)
             samples, _sr = sf.read(str(wav), dtype="float32")
-        model = WhisperModel(model_size, device="cpu", compute_type="int8")
+        model = _model(model_size)
         # no hint with the title: a prompt makes the recogniser spell the title right even when
         # the singer says it wrong, and the pronunciation check below needs to hear what was sung
-        segs, _info = model.transcribe(samples, language="en", vad_filter=False,
-                                       condition_on_previous_text=False)
-        return " ".join(s.text.strip() for s in segs)
+        # VAD on: this listens to the full mix, not an isolated vocal. Without it whisper treats
+        # three minutes of kick drums as speech and the generator never ends (see timeout_s).
+        # lyrics.heard_words still leaves VAD off: that path runs Demucs first.
+        def transcribe() -> str:
+            segs, _info = model.transcribe(
+                samples, language="en", vad_filter=True,
+                vad_parameters={"min_silence_duration_ms": 500, "speech_pad_ms": 400},
+                condition_on_previous_text=False, beam_size=1,
+                no_speech_threshold=0.6, compression_ratio_threshold=2.4)
+            parts, started = [], time.monotonic()
+            for s in segs:
+                if time.monotonic() - started > limit:
+                    break
+                if s.text.strip():
+                    parts.append(s.text.strip())
+            return " ".join(parts)
+
+        with ThreadPoolExecutor(max_workers=1) as pool:
+            fut = pool.submit(transcribe)
+            try:
+                return fut.result(timeout=limit)
+            except FuturesTimeout:
+                log(f"lyriccheck: transcription hit the {limit:.0f}s limit; treating as unchecked")
+                return None
     except Exception as exc:                          # noqa: BLE001
         log(f"lyriccheck: transcription failed ({str(exc)[:160]})")
         return None
