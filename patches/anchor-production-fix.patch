+"""Uniqueness window: every released master is heard, not only the newest forty."""
+from anchor.unique import catalogue_window
+
+
+def test_uniqueness_keeps_the_oldest_releases_not_only_the_newest():
+    """68 drops, newest first: a cap of 40 newest used to drop Then Do It (2026-09-04)."""
+    drops = [{"id": f"n{i}"} for i in range(68)]          # n0 newest, n67 oldest
+    assert [d["id"] for d in catalogue_window(drops)][-1] == "n67"
+    capped = [d["id"] for d in catalogue_window(drops, 40)]
+    assert capped[0] == "n0" and capped[-1] == "n67"
+    assert "n0" in capped and "n67" in capped and "n33" not in capped
+    assert catalogue_window(drops[:10], 40) == drops[:10]
+    assert catalogue_window(drops) == drops
