{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "www",
  "redirects": [
    {
      "source": "/how-to-1",
      "destination": "/how-to",
      "permanent": false
    },
    {
      "source": "/how-to-1/:path*",
      "destination": "/how-to/:path*",
      "permanent": false
    },
    {
      "source": "/how-to-2",
      "destination": "/how-to",
      "permanent": false
    },
    {
      "source": "/how-to-2/:path*",
      "destination": "/how-to/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/icons/favicon.svg"
    },
    {
      "source": "/how-to",
      "destination": "/how-to/index.html"
    },
    {
      "source": "/task-tracker",
      "destination": "/task-tracker.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/assets/(.*).pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ]
}
